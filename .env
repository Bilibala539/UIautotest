# UIAutotest 环境变量配置
# 说明: 本文件由 python-dotenv 在 conftest.py 中加载

# 目标平台: web (TidyTree) / android (智能音箱) / flutter (Swan Flutter)
PLATFORM=web

# Android 实机（将 PLATFORM 改为 android 或 flutter 后生效）
# ANDROID_DEVICE_SERIAL=设备序列号（可选；仅连接一台设备时可留空）
# ADB_PATH=adb（可选；adb 不在 PATH 时填写 adb.exe 的绝对路径）

# Swan Flutter 登录用例（仅 PLATFORM=flutter 生效；不要把真实密码提交到仓库）
# SWAN_PACKAGE=com.swan.network
# SWAN_PHONE=测试手机号
# SWAN_PASSWORD=测试密码

# Web 测试可选配置
# WEB_BROWSER=chrome
# WEB_HEADLESS=0
# WEB_BASE_URL=http://localhost:3000
# WEB_VIEWPORT_WIDTH=1440
# WEB_VIEWPORT_HEIGHT=900

# 分布式节点负责的用户列表 (逗号分隔, 留空则不过滤)
# NODE_USERS=userA,userB
